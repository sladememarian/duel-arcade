# Copy this file to .env and fill in the values. Never commit the real .env.
MONGO_ROOT_USER=arcade
MONGO_ROOT_PASSWORD=replace-with-a-long-random-password
MONGO_DB=arcade
# 64+ random hex characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret
MAX_USERS=60
# true only when served over HTTPS
COOKIE_SECURE=false
